NEXT_PUBLIC_ARC_ENVIRONMENT=testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SERVER_URL=
SETTLBOX_APP_ORIGIN=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
SETTLBOX_TREASURY_DATABASE=.data/treasury.sqlite
SETTLBOX_TREASURY_CONFIG=.data/treasury-config.json
SETTLBOX_SESSION_DATABASE=.data/sessions.sqlite
SETTLBOX_BUSINESS_DATABASE=.data/business.sqlite
SETTLBOX_GIFT_ESCROW_CONFIG=.data/gift-escrow.json
SETTLBOX_TREASURY_VAULT_CONFIG=.data/treasury-vault.json
SETTLBOX_UPLOAD_DIRECTORY=.data/uploads
SETTLBOX_OPERATOR_TOKEN=
SETTLBOX_LOGIN_EMAIL=
SETTLBOX_LOGIN_PASSWORD_HASH=
# Public addresses for deployment preparation; setting these does not deploy a vault.
SETTLBOX_VAULT_ADMINISTRATOR=
SETTLBOX_VAULT_EXECUTOR=
# Azure OpenAI configuration. Model integration is not enabled by these values alone.
SETTLBOX_AI_PROVIDER=azure
# Resource root URL, e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Azure deployment name, rather than a generic model identifier.
AZURE_OPENAI_DEPLOYMENT=settlbox-finance-chat
# Server-only credential. Configure locally; never use NEXT_PUBLIC_ for this key.
AZURE_OPENAI_API_KEY=
# Circle Console > Wallets > User Controlled > Configurator. Public application ID.
NEXT_PUBLIC_CIRCLE_APP_ID=
# Optional dedicated user-controlled API key; falls back to CIRCLE_API_KEY.
# Human PIN authorizations never use CIRCLE_ENTITY_SECRET.
CIRCLE_USER_CONTROLLED_API_KEY=
SETTLBOX_HUMAN_WALLET_DATABASE=.data/human-wallet-approvals.sqlite

# Verified Circle developer-controlled execution wallet registry.
SETTLBOX_AGENT_EXECUTOR_CONFIG=.data/agent-executor.json
# Server-only secret for the bounded finance runner. Generate at least 32 random characters.
SETTLBOX_FINANCE_WORKER_TOKEN=

# Optional remote MCP bearer token. Settings stores this variable name only.
SETTLBOX_MCP_ACCOUNTING_TOKEN=
# Inbound MCP credentials are created/revoked in Settings and stored hashed in the
# business database. Client bearer tokens belong in the external client's private
# environment; do not reuse SETTLBOX_OPERATOR_TOKEN or provider credentials.

# Per-business Kora sandbox secret. Live keys are rejected.
SETTLBOX_KORA_COMPANY_TEST_KEY=
SETTLBOX_KORA_COMPANY_TEST_PUBLIC_KEY=
# Server-only status reconciliation credential; cannot submit payouts.
SETTLBOX_PAYOUT_STATUS_TOKEN=
