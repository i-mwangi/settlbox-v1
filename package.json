{
  "name": "settlbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:arc": "tsc --project tsconfig.arc.json --noEmit",
    "verify:circle": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-circle-testnet.mjs",
    "verify:api": "node --env-file-if-exists=.env.local scripts/verify-treasury-api.mjs",
    "verify:business": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-business-records.mjs",
    "verify:workspace": "node --env-file-if-exists=.env.local scripts/verify-workspace.mjs",
    "schedules:prepare": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/prepare-scheduled-payments.mjs",
    "contracts:compile": "node scripts/compile-gift-escrow.mjs",
    "contracts:deploy": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/deploy-gift-escrow.mjs",
    "verify:gifts": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-gifts.mjs",
    "seed:reimbursements": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-reimbursements.mjs",
    "seed:provider-history": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-provider-history.mjs",
    "verify:reimbursements": "node --env-file-if-exists=.env.local scripts/verify-reimbursements.mjs"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@reactour/tour": "^3.8.0",
    "@tanstack/react-query": "^5.90.12",
    "blo": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconoir-react": "^7.11.0",
    "immer": "^10.2.0",
    "lodash": "^4.17.21",
    "motion": "^12.40.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.1",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.60.0",
    "react-hot-toast": "^2.5.2",
    "react-is": "^19.2.1",
    "react-loading-skeleton": "^3.5.0",
    "react-tooltip": "^5.29.1",
    "recharts": "^3.1.0",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.21.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@circle-fin/smart-contract-platform": "10.8.1",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-is": "^19",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.5.3",
    "solc": "0.8.30",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
